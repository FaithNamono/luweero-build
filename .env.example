# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- Database ---
# Local quick start (SQLite):
DATABASE_URL=sqlite:///./luweero_build.db
# Production (Supabase Postgres, use the pooled connection string):
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Cloud object storage (Supabase Storage, S3-compatible API) ---
STORAGE_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_REGION=eu-west-1
STORAGE_BUCKET=engineering-blueprints
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
# Public base URL of the bucket (used when the bucket is public)
STORAGE_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/engineering-blueprints
# Seconds a signed blueprint URL stays valid (used when STORAGE_USE_SIGNED_URLS=true)
STORAGE_USE_SIGNED_URLS=false
STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- Webhook security ---
# Optional. If set, callers must send it in the X-Webhook-Secret header (recommended in production)
WEBHOOK_SHARED_SECRET=

# --- Identity trust networks (mocked for this challenge) ---
LABOREMUS_API_KEY=replace-me
VERIFY_UG_API_KEY=replace-me
